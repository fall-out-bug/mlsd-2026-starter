    {
      "op": "expect_prediction",
      "request_id": "r-m2",
      "status": "ok",
      "features": {
        "order_count_90d": 1,
        "total_amount_90d": "15.000000",
        "average_order_amount_90d": "15.00",
        "days_since_last_order": 7,
        "distinct_stock_codes_90d": 1,
        "return_rate_90d": "0.000000",
        "order_count_30d": 1,
        "total_amount_30d": "15.000000"
      },
      "model_name": "hw4-logistic",
      "model_version": "1",
      "probability": 0.6558655847800694
