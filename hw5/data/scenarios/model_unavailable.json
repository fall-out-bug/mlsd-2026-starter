        "total_amount_30d": "10.000000"
      },
      "model_name": "hw4-logistic",
      "model_version": "1",
      "probability": 0.5972182463057413
    },
    {
      "op": "expect_status",
      "field": "predictions_written",
      "value": 2
    },
    {
      "op": "expect_status",
      "field": "requests_pending",
      "value": 0
    }
  ]
